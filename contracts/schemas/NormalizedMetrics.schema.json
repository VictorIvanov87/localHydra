{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "IncompleteReason": {
      "enum": [
        "no_final_chunk",
        "partial_final_chunk",
        "no_visible_token"
      ],
      "title": "IncompleteReason",
      "type": "string"
    },
    "MetricsCompleteness": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/MetricsStatus"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncompleteReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "MetricsCompleteness",
      "type": "object"
    },
    "MetricsStatus": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "MetricsStatus",
      "type": "string"
    },
    "RawOllamaMetrics": {
      "additionalProperties": false,
      "description": "Fields of Ollama's final stream chunk, verbatim (nanoseconds / counts). All optional.",
      "properties": {
        "total_duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Duration"
        },
        "load_duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Duration"
        },
        "prompt_eval_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Eval Count"
        },
        "prompt_eval_duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Eval Duration"
        },
        "eval_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Count"
        },
        "eval_duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Duration"
        }
      },
      "title": "RawOllamaMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "routing_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Routing Ms"
    },
    "wall_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wall Ms"
    },
    "ttft_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttft Ms"
    },
    "load_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Load Ms"
    },
    "prompt_eval_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Eval Ms"
    },
    "generation_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Ms"
    },
    "ollama_total_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ollama Total Ms"
    },
    "prompt_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens"
    },
    "generated_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated Tokens"
    },
    "prompt_tokens_per_second": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens Per Second"
    },
    "generation_tokens_per_second": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Tokens Per Second"
    },
    "raw_ollama": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawOllamaMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completeness": {
      "$ref": "#/$defs/MetricsCompleteness"
    }
  },
  "required": [
    "completeness"
  ],
  "title": "NormalizedMetrics",
  "type": "object"
}
